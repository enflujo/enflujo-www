{
  "name": "enflujo-www",
  "packageManager": "yarn@4.18.0",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4001",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "revisar": "astro check",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write --list-different .",
    "serve": "yarn server:start",
    "stop": "yarn server:stop",
    "restart": "yarn server:restart",
    "server:start": "pm2 start ecosystem.config.cjs",
    "server:stop": "pm2 stop ecosystem.config.cjs",
    "server:restart": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "start": "node ./publico/server/entry.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ssr": "node --test tests/ssr.integration.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@enflujo/alquimia": "^2.0.0",
    "@speed-highlight/core": "^2.1.0",
    "astro": "7.3.5",
    "autoprefixer": "^10.6.1",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "pm2": "^7.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.105.0",
    "schema-dts": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
