{
  "name": "enflujo-www",
  "packageManager": "yarn@4.18.0",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 3000",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "revisar": "astro check",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write --list-different .",
    "serve": "yarn server:start",
    "stop": "yarn server:stop",
    "restart": "yarn server:restart",
    "server:start": "yarn build && pm2 start ecosystem.config.js",
    "server:stop": "pm2 stop ecosystem.config.js",
    "server:restart": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@enflujo/alquimia": "^2.0.0",
    "@speed-highlight/core": "^2.1.0",
    "astro": "7.3.1",
    "astro-robots-txt": "^1.0.0",
    "autoprefixer": "^10.5.5",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.104.0",
    "schema-dts": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
